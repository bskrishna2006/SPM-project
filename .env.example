# ==========================================
# Student Task Management System (STMS)
# Environment Configuration Template
# ==========================================

# Server runtime environment
NODE_ENV=development
PORT=5000

# MongoDB Connection
# Paste your MongoDB Atlas URI below or use local MongoDB
# If left blank or unreachable in development, an embedded in-memory MongoDB will safely initialize automatically!
MONGODB_URI=mongodb://127.0.0.1:27017/student_task_management

# Frontend Client URL (for CORS and cookies)
CLIENT_URL=http://localhost:5173

# JWT Secret Configuration
JWT_ACCESS_SECRET=stms_super_secret_jwt_key_development_change_in_production_2026_xyz
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=stms_super_secret_refresh_jwt_key_development_change_in_production_2026_abc
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Configuration
COOKIE_NAME=stms_access_token
COOKIE_REFRESH_NAME=stms_refresh_token

# File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
